\set ON_ERROR_STOP on
\set ON_ERROR_ROLLBACK off
\set ECHO none
\set QUIET 1
\set VERBOSITY terse

\if :{?operator_database}
\else
    \set operator_database ''
\endif

SELECT current_database() = :'operator_database' AS operator_target_matches \gset
\if :operator_target_matches
\else
    DO $$ BEGIN RAISE EXCEPTION 'Set operator_database to the exact target database name'; END $$;
\endif

BEGIN ISOLATION LEVEL READ COMMITTED;
SET LOCAL search_path = pg_catalog, pg_temp;
SET LOCAL lock_timeout = '10s';
SET LOCAL statement_timeout = '30s';

CREATE TEMP TABLE operator_input (encoded text NOT NULL) ON COMMIT DROP;
\copy pg_temp.operator_input (encoded) FROM PSTDIN

CREATE TEMP TABLE operator_result (
    operation text NOT NULL,
    store_id text NOT NULL,
    account_id uuid NOT NULL,
    username text NOT NULL,
    role text NOT NULL,
    account_changed boolean NOT NULL,
    revoked_sessions bigint NOT NULL
) ON COMMIT PRESERVE ROWS;

DO $operator$
DECLARE
    source text;
    payload jsonb;
    action text;
    fields text[];
    location_id text;
    account_text text;
    account_key uuid;
    login_name text;
    account_role text;
    new_hash text;
    saved_hash text;
    was_enabled boolean;
    changed boolean := false;
    revoked bigint := 0;
BEGIN
    IF (SELECT count(*) FROM pg_temp.operator_input) <> 1 THEN
        RAISE EXCEPTION 'Supply exactly one base64-encoded UTF-8 JSON document';
    END IF;
    SELECT encoded INTO source FROM pg_temp.operator_input;
    IF length(source) NOT BETWEEN 4 AND 4096 OR length(source) % 4 <> 0
        OR source !~ '^[A-Za-z0-9+/]+={0,2}$' THEN
        RAISE EXCEPTION 'Supply exactly one base64-encoded UTF-8 JSON document';
    END IF;
    BEGIN
        source := convert_from(decode(source, 'base64'), 'UTF8');
        IF source IS NOT JSON OBJECT WITH UNIQUE KEYS THEN
            RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'Invalid JSON';
        END IF;
        payload := source::jsonb;
    EXCEPTION WHEN data_exception THEN
        RAISE EXCEPTION 'Operator request must be a UTF-8 JSON object with unique keys';
    END;

    action := payload->>'operation';
    fields := ARRAY['operation', 'storeId', 'accountId', 'username'];
    CASE action
        WHEN 'create' THEN fields := fields || ARRAY['role', 'passwordHash'];
        WHEN 'rotate' THEN fields := fields || ARRAY['passwordHash'];
        WHEN 'disable' THEN NULL;
        ELSE RAISE EXCEPTION 'Operation must be create, rotate or disable';
    END CASE;
    IF EXISTS (SELECT FROM unnest(fields) AS field(key)
        WHERE jsonb_typeof(payload->field.key) IS DISTINCT FROM 'string')
        OR EXISTS (SELECT FROM jsonb_object_keys(payload) AS field(key) WHERE field.key <> ALL(fields)) THEN
        RAISE EXCEPTION 'Operator request contains invalid, missing or unexpected fields';
    END IF;

    location_id := payload->>'storeId';
    account_text := payload->>'accountId';
    login_name := payload->>'username';
    IF location_id !~ '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$'
        OR account_text !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
        OR login_name !~ '^[a-z0-9][a-z0-9._-]{2,63}$' OR login_name LIKE 'demo-%' THEN
        RAISE EXCEPTION 'Invalid store ID, account UUID or non-demo username';
    END IF;
    account_key := account_text::uuid;

    IF action IN ('create', 'rotate') THEN
        new_hash := payload->>'passwordHash';
        -- The trailing characters enforce canonical unpadded base64url for the 16-byte salt and 32-byte key.
        IF new_hash !~ '^[$]pbkdf2-sha256[$]600000[$][A-Za-z0-9_-]{21}[AQgw][$][A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$' THEN
            RAISE EXCEPTION 'Use a password hash generated by OperatorPasswordHash';
        END IF;
    END IF;

    IF action = 'create' THEN
        account_role := payload->>'role';
        IF account_role NOT IN ('kitchen', 'pickup', 'manager') THEN
            RAISE EXCEPTION 'Invalid operator role';
        END IF;
        IF NOT EXISTS (SELECT FROM public.stores WHERE id = location_id) THEN
            RAISE EXCEPTION 'Operator store does not exist';
        END IF;
        INSERT INTO public.operator_accounts (id, store_id, username, role, password_hash)
        VALUES (account_key, location_id, login_name, account_role, new_hash)
        ON CONFLICT DO NOTHING;
        IF NOT FOUND THEN
            RAISE EXCEPTION 'Operator account ID or username already exists';
        END IF;
        changed := true;
    ELSE
        -- Match the login transaction's account-first locking order before touching its sessions.
        SELECT a.role, a.password_hash, a.enabled INTO account_role, saved_hash, was_enabled
        FROM public.operator_accounts a
        WHERE a.id = account_key AND a.store_id = location_id AND a.username = login_name
        FOR UPDATE;
        IF NOT FOUND THEN
            RAISE EXCEPTION 'Operator account does not match the store, UUID and username';
        END IF;

        IF action = 'rotate' THEN
            IF NOT was_enabled THEN
                RAISE EXCEPTION 'Cannot rotate a disabled operator account';
            END IF;
            IF new_hash <> saved_hash THEN
                UPDATE public.operator_accounts
                SET password_hash = new_hash, failed_logins = 0, login_blocked_until = NULL
                WHERE id = account_key;
                changed := true;
            END IF;
        ELSIF was_enabled THEN
            UPDATE public.operator_accounts SET enabled = false WHERE id = account_key;
            changed := true;
        END IF;

        IF changed OR action = 'disable' THEN
            DELETE FROM public.operator_sessions WHERE operator_id = account_key;
            GET DIAGNOSTICS revoked = ROW_COUNT;
        END IF;
    END IF;

    INSERT INTO pg_temp.operator_result
    VALUES (action, location_id, account_key, login_name, account_role, changed, revoked);
END
$operator$;

COMMIT;

SELECT operation, store_id, account_id, username, role, account_changed, revoked_sessions
FROM pg_temp.operator_result;
DROP TABLE pg_temp.operator_result;
