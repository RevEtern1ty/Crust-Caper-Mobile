{
  "name": "crustcaper-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint app src metro.config.js tooling",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "build:web": "expo export --platform web",
    "build:android": "expo export --platform android --output-dir dist-android",
    "build:ios": "expo export --platform ios --output-dir dist-ios",
    "sbom": "npm sbom --sbom-format cyclonedx"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "decode-uri-component": "0.5.1",
    "expo": "55.0.32",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.41",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@expo/cli": {
      "zod": "4.6.6"
    },
    "query-string": {
      "decode-uri-component": "$decode-uri-component"
    }
  }
}
