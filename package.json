{
  "name": "crustcaper-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint app app.config.ts src metro.config.js tooling tests",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "build:web": "expo export --platform web",
    "build:android": "expo export --platform android --output-dir dist-android",
    "build:ios": "expo export --platform ios --output-dir dist-ios",
    "sbom": "npm sbom --sbom-format cyclonedx",
    "test:web": "node --test tests/web.test.cjs",
    "build:connected-web": "expo export --platform web --output-dir dist-connected",
    "build:storefront-test": "node tooling/build-storefront-test.cjs",
    "test:connected": "node --test tests/connected.test.cjs",
    "test:storefront": "node tooling/storefront-stack.cjs",
    "test:storefront:load": "node tooling/storefront-stack.cjs --load",
    "test:storefront:load-smoke": "node tooling/storefront-stack.cjs --load-smoke",
    "test:storefront:web-perf": "node tooling/storefront-stack.cjs --web-perf",
    "test:storefront:catalog-photos": "node tooling/storefront-stack.cjs --catalog-photos",
    "test:storefront:payment-restart": "node tooling/storefront-stack.cjs --payment-restart",
    "test:storefront:kitchen-restart": "node tooling/storefront-stack.cjs --kitchen-restart",
    "start:local-stack": "node tooling/local-stack.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "decode-uri-component": "0.5.1",
    "expo": "55.0.32",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.41",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.0",
    "playwright-core": "1.65.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@expo/cli": {
      "zod": "4.6.6"
    },
    "query-string": {
      "decode-uri-component": "$decode-uri-component"
    }
  }
}
